# =========================================
# HORION TIME - Variables de Entorno
# =========================================

# Aplicación
APP_ENV=production
APP_URL=https://app.horiontime.co
APP_DEBUG=false

# Base de Datos
DB_HOST=db
DB_NAME=horion_time
DB_USER=horion_user
DB_PASSWORD=CHANGE_ME_strong_password_2026
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password_2026

# Seguridad
JWT_SECRET=CHANGE_ME_random_64_chars_string_abcdefghijklmnop
CSRF_SECRET=CHANGE_ME_csrf_secret_32_chars

# Email (SMTP)
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USER=apikey
MAIL_PASS=SG.xxxxxxxxxxxxx
MAIL_FROM=noreply@horiontime.co
MAIL_FROM_NAME="Horion Time"

# Timezone
APP_TIMEZONE=America/Bogota

# Rate Limiting
API_RATE_LIMIT_DEFAULT=100
API_RATE_LIMIT_LOGIN=10